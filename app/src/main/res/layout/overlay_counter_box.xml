<?xml version="1.0" encoding="utf-8"?>
<!-- The floating counter expanded by a long press: the dhikr, the counter large at its heart (a
     tap on it counts), and its actions in one bar: one step back, reset, reading along, and the
     full counter in the app. A drag anywhere but a button moves it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <!-- The grab handle (the box moves with a drag anywhere but its buttons), and close. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/overlay_handle" />

        <ImageButton
            android:id="@+id/overlay_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/overlay_button_round"
            android:contentDescription="@string/close"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="#B3FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/overlay_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/ibm_plex_sans_arabic_medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="3"
        android:textColor="#EBFFFFFF"
        android:textSize="16sp" />

    <!-- The counter itself, at the heart of the box: a tap on it counts. -->
    <FrameLayout
        android:id="@+id/overlay_dial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- The actions in one bar, hairlines between them: one step back, reset, reading along
         (gold, as the reader's play), and the full counter in the app. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/overlay_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/overlay_undo"
            style="@style/OverlayBarButton"
            android:contentDescription="@string/counter_undo"
            android:src="@drawable/ic_undo" />

        <View style="@style/OverlayBarDivider" />

        <ImageButton
            android:id="@+id/overlay_reset"
            style="@style/OverlayBarButton"
            android:contentDescription="@string/counter_reset"
            android:src="@drawable/ic_refresh" />

        <View style="@style/OverlayBarDivider" />

        <ImageButton
            android:id="@+id/overlay_play"
            style="@style/OverlayBarButton"
            android:contentDescription="@string/play"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            android:tint="#FFE6CF86" />

        <View style="@style/OverlayBarDivider" />

        <ImageButton
            android:id="@+id/overlay_expand"
            style="@style/OverlayBarButton"
            android:contentDescription="@string/overlay_expand"
            android:src="@drawable/ic_open_full" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- «التقويم الهجري»: the Hijri month, drawn to the widget's size (see Widgets.hijriMonth). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hijri_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_night">
    <ImageView android:id="@+id/hijri_image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:contentDescription="@string/widget_hijri_name" />
</FrameLayout>

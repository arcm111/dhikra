<?xml version="1.0" encoding="utf-8"?>
<!-- The «اليوم» widget: today's progress on the green header, then the sections of the period at hand. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background" android:layoutDirection="ltr">
    <LinearLayout android:id="@+id/today_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_header"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <TextView android:id="@+id/today_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" android:text="٢٢٪" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/today_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:text="تقدّم اليوم" />
            <ProgressBar android:id="@+id/today_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
                android:max="100" android:progress="22" android:progressDrawable="@drawable/widget_progress" />
            <TextView android:id="@+id/today_steps" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="#CCFFFFFF" android:textSize="12sp" android:text="أُنجز ٢٧ من ١٢٣ خطوة" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/today_period" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="2dp"
        android:textColor="#FF546C91" android:textSize="13sp" android:textStyle="bold" android:text="الآن · المغرب · ٣ أقسام" />
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="7dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/row1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:textColor="#FF1B1C19" android:textSize="14sp" android:text="اوراد صلاة المغرب" />
        <TextView android:id="@+id/row1_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF6B6A63" android:textSize="12sp" android:text="١٦:٢١" />
        <TextView android:id="@+id/row1_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:background="@drawable/widget_pill" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="#FF1B4E38" android:textSize="13sp" android:textStyle="bold" android:text="٠/٩" />
    </LinearLayout>
    <ImageView android:id="@+id/divider2" android:layout_width="match_parent" android:layout_height="1dp" android:importantForAccessibility="no"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="#FFEAE6DD" />
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="7dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/row2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:textColor="#FF1B1C19" android:textSize="14sp" android:text="وقت الآصال" />
        <TextView android:id="@+id/row2_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF6B6A63" android:textSize="12sp" android:text="١٦:٣٠" />
        <TextView android:id="@+id/row2_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:background="@drawable/widget_pill" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="#FF1B4E38" android:textSize="13sp" android:textStyle="bold" android:text="٠/٣" />
    </LinearLayout>
    <ImageView android:id="@+id/divider3" android:layout_width="match_parent" android:layout_height="1dp" android:importantForAccessibility="no"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="#FFEAE6DD" />
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="7dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/row3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:textColor="#FF1B1C19" android:textSize="14sp" android:text="مجلس المساء" />
        <TextView android:id="@+id/row3_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF6B6A63" android:textSize="12sp" android:text="١٨:٠٠" />
        <TextView android:id="@+id/row3_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:background="@drawable/widget_pill" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="#FF1B4E38" android:textSize="13sp" android:textStyle="bold" android:text="٠/٩" />
    </LinearLayout>
    <ImageView android:id="@+id/divider4" android:layout_width="match_parent" android:layout_height="1dp" android:importantForAccessibility="no"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:background="#FFEAE6DD" />
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="7dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/row4_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:textColor="#FF1B1C19" android:textSize="14sp" android:text="قبل النوم" />
        <TextView android:id="@+id/row4_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF6B6A63" android:textSize="12sp" android:text="٢٢:٣٠" />
        <TextView android:id="@+id/row4_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:background="@drawable/widget_pill" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="#FF1B4E38" android:textSize="13sp" android:textStyle="bold" android:text="✓" />
    </LinearLayout>
    <TextView android:id="@+id/today_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="14dp" android:textColor="#FF6B6A63" android:textSize="13sp" android:visibility="gone" />
</LinearLayout>
